# Copiar a .env.local y completar. `cp .env.example .env.local` (Windows: Copy-Item)
# Los valores de abajo son de ejemplo: los reales nunca van al repo.

# ── BASE DE DATOS ────────────────────────────────────────────────────────────
# El host del pooler es `aws-1-<REGION>.pooler.supabase.com` en algunos proyectos y
# `aws-0-...` en otros: NO se puede deducir del project ref. Copiar la cadena desde
# Supabase → Project Settings → Database → Connection string. Con el prefijo equivocado
# el pooler responde `tenant/user <ref> not found` aun con usuario y contraseña correctos.
#
# connection_limit=1 es OBLIGATORIO detrás de un pooler en serverless: Vercel corre
# varias instancias a la vez y cada una abre sus conexiones. Con un valor más alto se
# agota el pool y TODOS los endpoints que tocan la base devuelven 500, mientras los que
# no la tocan siguen respondiendo bien. `src/lib/db.ts` lo agrega solo si falta.
#
# DATABASE_URL (runtime) → usar el POOLER de Supabase:
#   postgresql://postgres.<REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=1
DATABASE_URL=""

# DIRECT_URL (migraciones) → conexión directa, obligatoria para `prisma migrate`.
# En una red sin salida IPv6 (donde db.<REF>.supabase.co no resuelve a IPv4) también
# tiene que apuntar al pooler.
DIRECT_URL="postgresql://postgres.<REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=1"

# ── AUTENTICACIÓN ────────────────────────────────────────────────────────────
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# ── JOB PROGRAMADO ───────────────────────────────────────────────────────────
# Generar igual que AUTH_SECRET. El endpoint /api/cron/licitaciones lo exige.
CRON_SECRET=""

# ── EMAIL (Resend) ───────────────────────────────────────────────────────────
# resend.com → API Keys → Create API Key
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# Con dominio verificado: "Licitaciones <notificaciones@tu-dominio.com>"
EMAIL_FROM="Licitaciones <onboarding@resend.dev>"

# ── SUPABASE STORAGE ─────────────────────────────────────────────────────────
# Project Settings → API Keys. El bucket "propuestas" debe existir (privado).
NEXT_PUBLIC_SUPABASE_URL="https://<REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ── APP ──────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
