# Copiar a .env.local y completar. `cp .env.example .env.local` (Windows: Copy-Item)
# Los valores de abajo son de ejemplo: los reales nunca van al repo.

# ── BASE DE DATOS ────────────────────────────────────────────────────────────
# DATABASE_URL (runtime) → usar el POOLER de Supabase en producción:
#   postgresql://postgres.<REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require&pgbouncer=true&connection_limit=1
# En local podés usar la conexión directa sin pooler.
DATABASE_URL=""

# DIRECT_URL (migraciones) → conexión directa, obligatoria para `prisma migrate`.
DIRECT_URL="postgresql://postgres.<REF>:<PASSWORD>@db.<REF>.supabase.co:5432/postgres?sslmode=require&schema=public"

# ── AUTENTICACIÓN ────────────────────────────────────────────────────────────
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# ── JOB PROGRAMADO ───────────────────────────────────────────────────────────
# Generar igual que AUTH_SECRET. El endpoint /api/cron/licitaciones lo exige.
CRON_SECRET=""

# ── EMAIL (Resend) ───────────────────────────────────────────────────────────
# resend.com → API Keys → Create API Key
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# Con dominio verificado: "Licitaciones <notificaciones@tu-dominio.com>"
EMAIL_FROM="Licitaciones <onboarding@resend.dev>"

# ── SUPABASE STORAGE ─────────────────────────────────────────────────────────
# Project Settings → API Keys. El bucket "propuestas" debe existir (privado).
NEXT_PUBLIC_SUPABASE_URL="https://<REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ── APP ──────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
